#pragma once

#define RS_STD_VERSION_STR "@PROJECT_VERSION@"
#define RS_STD_VERSION_MAJOR_STR "@PROJECT_VERSION_MAJOR@"
#define RS_STD_VERSION_MINOR_STR "@PROJECT_VERSION_MINOR@"
#define RS_STD_VERSION_PATCH_STR "@PROJECT_VERSION_PATCH@"

#define RS_STD_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define RS_STD_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define RS_STD_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define RS_STD_MAKE_VERSION(major, minor, patch) \
    (((major) << 16) | ((minor) << 8) | (patch))

#define RS_STD_VERSION \
    RS_STD_MAKE_VERSION(RS_STD_VERSION_MAJOR, RS_STD_VERSION_MINOR, RS_STD_VERSION_PATCH)
